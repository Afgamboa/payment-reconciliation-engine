generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Webhooks_Events {
  id            String    @id @default(uuid())
  provider      String
  eventId       String
  paymentId     String
  type          String
  status        String    @default("RECEIVED")
  rawPayload    Json
  occurredAt    DateTime
  correlationId String
  attempts      Int       @default(0)
  lastError     String?
  receivedAt    DateTime  @default(now())
  nextRetryAt   DateTime?

  attemptsLog Payment_Attempts[]

  @@unique([provider, eventId])
  @@index([status, nextRetryAt])
  @@index([provider, paymentId])
}

model Payments {
  id                String   @id @default(uuid())
  provider          String
  providerPaymentId String
  amount            Int
  currency          String
  status            String
  lastEventAt       DateTime
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([status, updatedAt])
}

model Payment_Attempts {
  id            String    @id @default(uuid())
  eventId       String
  attemptNumber Int
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  outcome       String?
  error         String?

  event Webhooks_Events @relation(fields: [eventId], references: [id])

  @@unique([eventId, attemptNumber])
}

