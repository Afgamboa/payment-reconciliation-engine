PORT=3000

PAYMENT_DB_PORT=5432
PAYMENT_DB_USER=payment_engine_user
PAYMENT_DB_PASSWORD=change-me
PAYMENT_DB_NAME=payment-engine
DATABASE_URL="postgresql://payment_engine_user:change-me@localhost:5432/payment-engine?schema=public"

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# HMAC secret shared with the payment provider (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=
# Key required in the x-admin-key header of /api/admin/* endpoints
ADMIN_API_KEY=

# Optional tuning (defaults shown)
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=5
WORKER_LEASE_MS=30000
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
RECONCILIATION_STUCK_AFTER_MS=300000
RECONCILIATION_BATCH_SIZE=50
MOCK_PROVIDER_FAILURE_RATE=0
